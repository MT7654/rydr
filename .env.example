# Rydr runtime configuration — placeholders only. Never commit real secrets.
# Only server-side modules may read these. The client bundle must never see them.

# Execution mode: fixture | live | replay
RYDR_AGENT_MODE=fixture

# Live provider selection. One live adapter is implemented at a time.
#   adp = Tencent ADP published role agents (HTTP SSE)
RYDR_AGENT_PROVIDER=adp

# Shared, atomic call budget. Defaults below match product spec section 10.
RYDR_MAX_CALLS_PER_RUN=10
RYDR_MAX_CALLS_PER_SESSION=30

# --- Tencent ADP HTTP SSE ---
# The ADP HTTP SSE API authenticates via AppKey in the request body only.
# No SecretId/SecretKey is required for this endpoint.
# Endpoint is edition/account specific: verify in your ADP console.
RYDR_ADP_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat
RYDR_ADP_RIDER_APPKEY=
RYDR_ADP_DRIVER_APPKEY=
RYDR_ADP_JUDGE_APPKEY=

# Optional live Case Navigator (fourth ADP agent)
RYDR_ADP_NAVIGATOR_APPKEY=

# Account-independent, single-server daily paid-attempt guard (UTC reset).
# Failed attempts count. 0 disables paid provider calls; not a Tencent billing cap.
RYDR_MAX_PROVIDER_CALLS_PER_DAY=200

# Optional ADP Image Evidence Analyst: activation is deliberately last.
RYDR_ADP_VISION_APPKEY=
RYDR_VISION_PROVIDER=adp
RYDR_VISION_MODE=fixture
RYDR_VISION_VERIFIED=false

# Optional automatic ADP image upload (server-side cloud credentials).
# Not required for text agents or fixture evaluation.
ADP_SecretId=
ADP_SecretKey=
# Opt in only after reviewing public-image processing and user consent.
RYDR_ADP_PUBLIC_IMAGE_UPLOADS_AUTHORIZED=false

# Durable hosted storage (Neon CLI pulls the real values into the private .env).
# Leave file mode for credential-free judging; use neon for hosted deployments.
RYDR_STORAGE_BACKEND=file
RYDR_STORAGE_NAMESPACE=rydr
RYDR_STORAGE_BUCKET=assets
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
